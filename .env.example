# Kalshi Trading Bot — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Credentials -------------------------------------------------------------
# Your Kalshi API key ID (UUID) from Profile -> API Keys.
KALSHI_API_KEY_ID=

# Path to your RSA private key PEM file.
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# --- Environment -------------------------------------------------------------
# 'demo' = sandbox, 'prod' = live trading.
KALSHI_ENVIRONMENT=demo

# --- Safety ------------------------------------------------------------------
# true = simulated orders
# false = orders can be sent to Kalshi when running --live
KALSHI_DRY_RUN=true

# HTTP request timeout (seconds).
KALSHI_REQUEST_TIMEOUT=10

# Seconds between market polls.
KALSHI_POLL_INTERVAL=1


# --- Commodity underlying feed -----------------------------------------------
# Put your OANDA practice API token here.
# Used for Gold, Silver, Copper, WTI Oil, and Natural Gas.
# Kalshi's underlying-value stream is used as fallback.
KALSHI_PYTH_API_KEY=


# --- Risk limits -------------------------------------------------------------
KALSHI_RISK__MAX_CONTRACTS_PER_ORDER=200
KALSHI_RISK__MAX_POSITION_PER_MARKET=500
KALSHI_RISK__MAX_ORDER_NOTIONAL_CENTS=50000
KALSHI_RISK__KELLY_FRACTION=0.25
