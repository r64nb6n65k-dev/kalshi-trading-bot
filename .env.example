# Kalshi Trading Bot — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Credentials -------------------------------------------------------------
# Your Kalshi API key ID (UUID) from Profile -> API Keys.
KALSHI_API_KEY_ID=

# Path to your RSA private key PEM file.
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# --- Environment -------------------------------------------------------------
# 'demo' = sandbox, 'prod' = live trading.
KALSHI_ENVIRONMENT=demo

# --- Safety ------------------------------------------------------------------
# true = simulated orders
# false = orders can be sent to Kalshi when running --live
KALSHI_DRY_RUN=true

# HTTP request timeout (seconds).
KALSHI_REQUEST_TIMEOUT=10

# Seconds between market polls.
KALSHI_POLL_INTERVAL=1


# --- Commodity underlying feed -----------------------------------------------
# Put your OANDA practice API token here.
# Used for Gold, Silver, Copper, WTI Oil, and Natural Gas.
# Kalshi's underlying-value stream is used as fallback.
KALSHI_PYTH_API_KEY=


# --- Risk limits -------------------------------------------------------------
KALSHI_RISK__MAX_CONTRACTS_PER_ORDER=200
KALSHI_RISK__MAX_POSITION_PER_MARKET=500
KALSHI_RISK__MAX_ORDER_NOTIONAL_CENTS=50000
KALSHI_RISK__KELLY_FRACTION=0.25


# --- Weather bot (see WEATHER_BOT.md) -----------------------------------------
# api.weather.gov requires a User-Agent that identifies you.
KALSHI_WEATHER__USER_AGENT="kalshi-weather-bot (you@example.com)"
KALSHI_WEATHER__STATIONS=NYC,CHI,AUS,MIA,DEN
KALSHI_WEATHER__KINDS=high,low
KALSHI_WEATHER__DATA_DIR=./data/weather

# Edge and sizing
KALSHI_WEATHER__MIN_EDGE=0.08
KALSHI_WEATHER__CONFIDENCE=0.5
KALSHI_WEATHER__INTRADAY_CONFIDENCE=0.25
KALSHI_WEATHER__MIN_PRICE=12
KALSHI_WEATHER__MAX_PRICE=88
KALSHI_WEATHER__MAX_CONTRACTS_PER_ORDER=50
KALSHI_WEATHER__MAX_COST_PER_MARKET_CENTS=1500
KALSHI_WEATHER__MAX_COST_PER_EVENT_CENTS=2500
KALSHI_WEATHER__MAX_COST_PER_DAY_CENTS=10000
KALSHI_WEATHER__PAPER_BANKROLL_CENTS=50000

# Optional: paid Open-Meteo key (free tier is non-commercial).
KALSHI_WEATHER__OPENMETEO_API_KEY=

# Optional: override a series ticker if Kalshi renames one.
# KALSHI_WEATHER__SERIES_OVERRIDES={"NYC:low": "KXLOWTNYC"}
